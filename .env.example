####################################################################
# 凭证与环境配置模板 —— 复制为 .env 后填入真实值
#
#   cp .env.example .env
#
# ⚠️ `.env` 已在 .gitignore 中忽略，且仓库装有 pre-commit 扫描钩子
#    （scripts/install_git_hooks.sh），双重保险防止凭证入库。
# ⚠️ 本文件是**公开模板**，所有值一律用占位符，
#    不要把真实的 APPID / 账号 UIN / bucket 名 / 实例 ID 写进来。
####################################################################

# ------------------------------------------------------------------
# 1) 腾讯云 OpenAPI 密钥
#    控制台 → 访问管理 CAM → 访问密钥：https://console.cloud.tencent.com/cam/capi
# ------------------------------------------------------------------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-shanghai

# CAM 角色 ARN（沙箱拉取自定义镜像用），形如 qcs::cam::uin/<UIN>:roleName/<ROLE>
AGS_ROLE_ARN=

# ------------------------------------------------------------------
# 2) Agent SandBox（AGS）—— Agent 解题的隔离执行环境
#    E2B_API_KEY：AGS 控制台 → API Keys
#    E2B_DOMAIN ：把 E2B SDK 指向腾讯云
# ------------------------------------------------------------------
E2B_API_KEY=
E2B_DOMAIN=ap-shanghai.tencentags.com
# 复用的共享沙箱工具名（用 image_override 逐题切镜像，无需每题建工具）
AGS_TOOL_NAME=

# ------------------------------------------------------------------
# 3) 容器镜像服务 TCR —— SWE-bench 官方镜像转存在此
#    NAMESPACE 含账号标识，务必只写在 .env 里
# ------------------------------------------------------------------
TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_NAMESPACE=
TCR_USERNAME=
TCR_PASSWORD=
TCR_REGISTRY_TYPE=personal

# ------------------------------------------------------------------
# 4) COS —— SandBox ↔ TKE 之间传递 tracing / 权重 / 交付物
#    bucket 名格式为 <name>-<APPID>，含 APPID，只写在 .env 里
# ------------------------------------------------------------------
COS_REGION=ap-beijing
COS_BUCKET=

# ------------------------------------------------------------------
# 5) GPU 宿主机远程监督通道（云助手 TAT）
#    见 scripts/node.py。实例 ID 属内部资源标识，只写在 .env 里
# ------------------------------------------------------------------
GPU_NODE_REGION=ap-beijing
GPU_NODE_INSTANCE_ID=
GPU_NODE_WORKDIR=/data/swe-rl

# ------------------------------------------------------------------
# 6) 线 A 推理服务（GPU 节点上的 vLLM，沙箱内 Agent 通过它取 action）
#    LLM_API_KEY 必填且必须是强随机值 —— 服务一旦经 NAT 暴露到公网，
#    这是唯一的鉴权屏障。生成：openssl rand -hex 32
# ------------------------------------------------------------------
LLM_ENDPOINT=
LLM_API_KEY=
MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct

# ------------------------------------------------------------------
# 7) NAT DNAT 端口转发（把 GPU 节点的推理端口临时映射到公网）
#    详见 scripts/manage_nat_dnat.py。采集窗口结束后必须删除规则。
# ------------------------------------------------------------------
NAT_GATEWAY_ID=
NAT_EIP=
GPU_NODE_PRIVATE_IP=
LLM_PORT=
